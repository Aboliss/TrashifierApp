<?xml version="1.0" encoding="utf-8"?>
<!-- Wide widget: the next four collection days with a dot per bin. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Season variants: the code shows one background and its decorations. -->
    <ImageView
        android:id="@+id/wide_bg_normal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background_wide"
        android:visibility="visible" />
    <ImageView
        android:id="@+id/wide_bg_halloween"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background_wide_halloween"
        android:visibility="gone" />
    <ImageView
        android:id="@+id/wide_bg_christmas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background_wide_christmas"
        android:visibility="gone" />
    <ImageView
        android:id="@+id/wide_lights"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_gravity="top"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_lights"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/wide_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/wide_empty"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_bin_buddy" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_pickup_scheduled"
                android:textColor="@color/widget_wide_text"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wide_col_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_wide_highlight"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="6dp"
            android:visibility="invisible">

            <TextView
            android:id="@+id/wide_when_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textStyle="bold"
            android:text=""
            android:textColor="@color/widget_wide_accent"
            android:textSize="12sp" />

            <TextView
            android:id="@+id/wide_day_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:text=""
            android:textColor="@color/widget_wide_text"
            android:textSize="18sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/wide_dot_0_0"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="3dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_dot"
                        android:tint="@color/plastic_color"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/wide_dot_0_1"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="3dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_dot"
                        android:tint="@color/paper_color"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/wide_dot_0_2"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="3dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_dot"
                        android:tint="@color/trash_on_dark"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/wide_dot_0_3"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="3dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_dot"
                        android:tint="@color/bio_on_dark"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/wide_more_0"
                        android:layout_width="wrap_content"
                        android:layout_height="10dp"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center_vertical"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:text=""
                        android:textColor="@color/widget_wide_text"
                        android:textSize="10sp"
                        android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wide_col_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="6dp"
            android:visibility="invisible">

            <TextView
            android:id="@+id/wide_when_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textStyle="bold"
            android:text=""
            android:textColor="@color/widget_wide_text_secondary"
            android:textSize="12sp" />

            <TextView
            android:id="@+id/wide_day_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:text=""
            android:textColor="@color/widget_wide_text"
            android:textSize="18sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/wide_dot_1_0"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="3dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_dot"
                        android:tint="@color/plastic_color"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/wide_dot_1_1"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="3dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_dot"
                        android:tint="@color/paper_color"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/wide_dot_1_2"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="3dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_dot"
                        android:tint="@color/trash_on_dark"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/wide_dot_1_3"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="3dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_dot"
                        android:tint="@color/bio_on_dark"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/wide_more_1"
                        android:layout_width="wrap_content"
                        android:layout_height="10dp"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center_vertical"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:text=""
                        android:textColor="@color/widget_wide_text"
                        android:textSize="10sp"
                        android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wide_col_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="6dp"
            android:visibility="invisible">

            <TextView
            android:id="@+id/wide_when_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textStyle="bold"
            android:text=""
            android:textColor="@color/widget_wide_text_secondary"
            android:textSize="12sp" />

            <TextView
            android:id="@+id/wide_day_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:text=""
            android:textColor="@color/widget_wide_text"
            android:textSize="18sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/wide_dot_2_0"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="3dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_dot"
                        android:tint="@color/plastic_color"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/wide_dot_2_1"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="3dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_dot"
                        android:tint="@color/paper_color"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/wide_dot_2_2"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="3dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_dot"
                        android:tint="@color/trash_on_dark"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/wide_dot_2_3"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="3dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_dot"
                        android:tint="@color/bio_on_dark"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/wide_more_2"
                        android:layout_width="wrap_content"
                        android:layout_height="10dp"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center_vertical"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:text=""
                        android:textColor="@color/widget_wide_text"
                        android:textSize="10sp"
                        android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wide_col_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="6dp"
            android:visibility="invisible">

            <TextView
            android:id="@+id/wide_when_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textStyle="bold"
            android:text=""
            android:textColor="@color/widget_wide_text_secondary"
            android:textSize="12sp" />

            <TextView
            android:id="@+id/wide_day_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:text=""
            android:textColor="@color/widget_wide_text"
            android:textSize="18sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/wide_dot_3_0"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="3dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_dot"
                        android:tint="@color/plastic_color"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/wide_dot_3_1"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="3dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_dot"
                        android:tint="@color/paper_color"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/wide_dot_3_2"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="3dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_dot"
                        android:tint="@color/trash_on_dark"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/wide_dot_3_3"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="3dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_dot"
                        android:tint="@color/bio_on_dark"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/wide_more_3"
                        android:layout_width="wrap_content"
                        android:layout_height="10dp"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center_vertical"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:text=""
                        android:textColor="@color/widget_wide_text"
                        android:textSize="10sp"
                        android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
