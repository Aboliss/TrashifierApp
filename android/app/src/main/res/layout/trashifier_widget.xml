<!-- Trashifier Widget Layout -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <!--
        Color segments for the next pickup day, stacked bottom to top.
        Each shows a left-anchored clip of its bin color, so together they
        render [segment_1 | segment_2 | segment_3] with rounded outer corners.
    -->
    <ImageView
        android:id="@+id/segment_3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/segment_2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/segment_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center">

        <!-- App Icon for when no pickup is scheduled -->
        <ImageView
            android:id="@+id/app_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@mipmap/launcher_icon"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Days Until Text -->
        <TextView
            android:id="@+id/days_until_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_pickup_scheduled"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:shadowColor="#40000000"
            android:shadowDy="1"
            android:shadowRadius="2" />

        <!-- Date Text -->
        <TextView
            android:id="@+id/pickup_date_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textColor="@color/widget_text_secondary"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:lines="1"
            android:ellipsize="end"
            android:shadowColor="#40000000"
            android:shadowDy="1"
            android:shadowRadius="2" />

    </LinearLayout>

</FrameLayout>
