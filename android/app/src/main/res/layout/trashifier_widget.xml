<?xml version="1.0" encoding="utf-8"?>
<!--
    Bold widget: the next pickup on its bin colors.

    Color segments for the next pickup day, stacked bottom to top. Each shows
    a left-anchored clip of the tinted segment shape, so together they render
    [segment_1 | ... | segment_4] with rounded outer corners. Drawables are
    set here, not from code, and colors are sent as values
    (see TrashifierWidget.kt).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <ImageView
        android:id="@+id/segment_4"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_segment"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/segment_3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_segment"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/segment_2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_segment"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/segment_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_segment"
        android:visibility="gone" />

    <!-- Christmas lights along the top; the code shows them in season. -->
    <ImageView
        android:id="@+id/bold_lights"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_gravity="top"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_lights"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/bold_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/app_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_bin_buddy"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/bold_text_narrow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
        android:id="@+id/days_until_text"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:autoSizeMaxTextSize="26sp"
        android:autoSizeMinTextSize="15sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:maxLines="1"
        android:fontFamily="sans-serif-black"
        android:text=""
        android:textColor="@color/widget_text_on_dark"
        android:textSize="26sp" />

            <TextView
        android:id="@+id/pickup_date_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textStyle="bold"
        android:text=""
        android:textColor="@color/widget_text_secondary_on_dark"
        android:textSize="14sp" />
        </LinearLayout>

        <!--
            Wider sizes: the text keeps its natural width so the Halloween
            spider can hang right next to it. (The narrow column above shrinks
            its text instead; the code shows one of the two.)
        -->
        <LinearLayout
            android:id="@+id/bold_text_wide"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/days_until_text_wide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/widget_text_on_dark"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/pickup_date_text_wide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/widget_text_secondary_on_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Hangs from the widget's top edge: the row has no top padding
                 outside Christmas (padUnderLights in TrashifierWidget.kt). -->
            <ImageView
                android:id="@+id/bold_spider"
                android:layout_width="20dp"
                android:layout_height="44dp"
                android:layout_gravity="top"
                android:layout_marginStart="10dp"
                android:layout_marginTop="3dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_spider"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/icon_slot_plastic"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_icon_circle"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/icon_plastic"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bin_plastic" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/icon_slot_paper"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_icon_circle"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/icon_paper"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bin_paper" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/icon_slot_trash"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_icon_circle"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/icon_trash"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bin_trash" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/icon_slot_bio"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_icon_circle"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/icon_bio"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bin_bio" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
