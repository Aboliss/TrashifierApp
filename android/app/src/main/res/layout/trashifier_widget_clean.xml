<?xml version="1.0" encoding="utf-8"?>
<!-- Clean widget: the next pickup on a plain card, bins as round tokens. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Season variants: the code shows one background and its decorations. -->
    <ImageView
        android:id="@+id/clean_bg_normal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background_clean"
        android:visibility="visible" />
    <ImageView
        android:id="@+id/clean_bg_halloween"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background_clean_halloween"
        android:visibility="gone" />
    <ImageView
        android:id="@+id/clean_lights"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_gravity="top"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_lights"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/clean_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/clean_buddy"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_bin_buddy_themed"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/clean_text_narrow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
            android:id="@+id/clean_days_text"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:autoSizeMaxTextSize="26sp"
            android:autoSizeMinTextSize="15sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:maxLines="1"
            android:fontFamily="sans-serif-black"
            android:text=""
            android:textColor="@color/widget_clean_text"
            android:textSize="26sp" />

            <TextView
            android:id="@+id/clean_date_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textStyle="bold"
            android:text=""
            android:textColor="@color/widget_clean_text_secondary"
            android:textSize="14sp" />

            <!-- Narrow widgets show the bins as dots instead of tokens. -->
            <LinearLayout
                android:id="@+id/clean_dots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/clean_dot_0"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="3dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot"
                    android:tint="@color/plastic_color"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/clean_dot_1"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="3dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot"
                    android:tint="@color/paper_color"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/clean_dot_2"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="3dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot"
                    android:tint="@color/trash_color"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/clean_dot_3"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="3dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot"
                    android:tint="@color/bio_color"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/clean_dots_more"
                    android:layout_width="wrap_content"
                    android:layout_height="10dp"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center_vertical"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="@color/widget_clean_text"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!--
            Wider sizes: the text keeps its natural width so the Halloween
            spider can hang right next to it. (The narrow column above shrinks
            its text instead; the code shows one of the two.)
        -->
        <LinearLayout
            android:id="@+id/clean_text_wide"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/clean_days_text_wide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/widget_clean_text"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/clean_date_text_wide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/widget_clean_text_secondary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Hangs from the widget's top edge: the row has no top padding
                 outside Christmas (padUnderLights in TrashifierWidget.kt). -->
            <ImageView
                android:id="@+id/clean_spider"
                android:layout_width="20dp"
                android:layout_height="44dp"
                android:layout_gravity="top"
                android:layout_marginStart="10dp"
                android:layout_marginTop="3dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_spider"
                android:visibility="gone" />
        </LinearLayout>

            <FrameLayout
                android:id="@+id/token_0"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="4dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/token_bg_0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot"
                    android:tint="@color/plastic_color" />

                <ImageView
                    android:id="@+id/token_icon_0"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bin_plastic"
                    android:tint="@color/widget_ink" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/token_1"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="4dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/token_bg_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot"
                    android:tint="@color/paper_color" />

                <ImageView
                    android:id="@+id/token_icon_1"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bin_paper"
                    android:tint="#FFFFFFFF" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/token_2"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="4dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/token_bg_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot"
                    android:tint="@color/trash_color" />

                <ImageView
                    android:id="@+id/token_icon_2"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bin_trash"
                    android:tint="#FFFFFFFF" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/token_3"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="4dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/token_bg_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot"
                    android:tint="@color/bio_color" />

                <ImageView
                    android:id="@+id/token_icon_3"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bin_bio"
                    android:tint="#FFFFFFFF" />
            </FrameLayout>

            <!-- "+N" when more bins go out than there are tokens. -->
            <TextView
                android:id="@+id/clean_more"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text=""
                android:textColor="@color/widget_clean_text"
                android:textSize="16sp"
                android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
