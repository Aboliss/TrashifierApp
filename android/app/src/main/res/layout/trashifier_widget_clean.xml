<?xml version="1.0" encoding="utf-8"?>
<!-- Clean widget: the next pickup on a plain card, bins as round tokens. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Season variants: the code shows one background and its decorations. -->
    <ImageView
        android:id="@+id/clean_bg_normal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background_clean"
        android:visibility="visible" />
    <ImageView
        android:id="@+id/clean_bg_halloween"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background_clean_halloween"
        android:visibility="gone" />
    <ImageView
        android:id="@+id/clean_snow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_snowflakes"
        android:visibility="gone" />
    <ImageView
        android:id="@+id/clean_holly"
        android:layout_width="40dp"
        android:layout_height="19dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="6dp"
        android:layout_marginEnd="12dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_holly"
        android:visibility="gone" />
    <ImageView
        android:id="@+id/clean_pumpkin"
        android:layout_width="26dp"
        android:layout_height="24dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="4dp"
        android:layout_marginEnd="10dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_pumpkin"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/clean_buddy"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_bin_buddy_themed"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
            android:id="@+id/clean_days_text"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:autoSizeMaxTextSize="26sp"
            android:autoSizeMinTextSize="15sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:maxLines="1"
            android:fontFamily="sans-serif-black"
            android:text=""
            android:textColor="@color/widget_clean_text"
            android:textSize="26sp" />

            <TextView
            android:id="@+id/clean_date_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textStyle="bold"
            android:text=""
            android:textColor="@color/widget_clean_text_secondary"
            android:textSize="14sp" />

            <!-- Narrow widgets show the bins as dots instead of tokens. -->
            <LinearLayout
                android:id="@+id/clean_dots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/clean_dot_plastic"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="3dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot"
                    android:tint="@color/plastic_color"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/clean_dot_paper"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="3dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot"
                    android:tint="@color/paper_color"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/clean_dot_trash"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="3dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot"
                    android:tint="@color/trash_color"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/clean_dot_bio"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="3dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot"
                    android:tint="@color/bio_color"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

            <FrameLayout
                android:id="@+id/token_plastic"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="4dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot"
                    android:tint="@color/plastic_color" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bin_plastic"
                    android:tint="@color/widget_ink" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/token_paper"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="4dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot"
                    android:tint="@color/paper_color" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bin_paper"
                    android:tint="#FFFFFFFF" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/token_trash"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="4dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot"
                    android:tint="@color/trash_color" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bin_trash"
                    android:tint="#FFFFFFFF" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/token_bio"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="4dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_dot"
                    android:tint="@color/bio_color" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bin_bio"
                    android:tint="#FFFFFFFF" />
            </FrameLayout>
    </LinearLayout>
</FrameLayout>
